{
  "name": "@ai-setting/roy-bot-desktop",
  "version": "1.5.4",
  "description": "Roy Agent Desktop - GUI application for AI agents",
  "author": "Roy Agent Team",
  "type": "module",
  "main": "electron/dist/main.js",
  "scripts": {
    "dev": "vite",
    "build:electron": "bun run electron/build-preload.js",
    "dev:electron": "bun run electron/build-preload.js && concurrently \"vite\" \"npm run electron:dev\"",
    "electron:dev": "wait-on http://localhost:1420 && cross-env NODE_ENV=development electron .",
    "preelectron:build": "node -e \"const fs=require('fs');const path=require('path');const pkgDir=process.cwd();const nodeModulesSrc=path.join(pkgDir,'node_modules');const nodeModulesDest=path.join(pkgDir,'vendor/node_modules');fs.mkdirSync(path.join(pkgDir,'vendor'),{recursive:true});if(fs.existsSync(nodeModulesSrc)){fs.rmSync(nodeModulesDest,{recursive:true,force:true});fs.cpSync(nodeModulesSrc,nodeModulesDest,{recursive:true});console.log('Copied node_modules to vendor/')}\"",
    "electron:build": "node electron/build-preload.js && electron-builder --config electron-builder.json",
    "build": "vite build",
    "build:check": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "test": "node node_modules/vitest/vitest.mjs run",
    "test:watch": "node node_modules/vitest/vitest.mjs",
    "test:bun": "bun test"
  },
  "dependencies": {
    "@ai-sdk/gateway": "^3.0.112",
    "@ai-sdk/provider": "^3.0.10",
    "@ai-sdk/provider-utils": "^4.0.27",
    "@ai-setting/roy-bot-core": "workspace:*",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentelemetry/api": "^1.9.1",
    "better-sqlite3": "^11.0.0",
    "cross-spawn": "^7.0.6",
    "electron-store": "^10.0.0",
    "eventsource-parser": "^3.0.8",
    "highlight.js": "^11.11.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^2.1.0",
    "rehype-highlight": "^7.0.2",
    "remark-gfm": "^4.0.1",
    "zod": "^3.25.76",
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@electron/rebuild": "^4.0.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.2",
    "@types/better-sqlite3": "^7.6.0",
    "@types/node": "^22.0.0",
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "autoprefixer": "^10.4.0",
    "concurrently": "^8.0.0",
    "cross-env": "^7.0.0",
    "electron": "^31.0.0",
    "electron-builder": "^24.0.0",
    "esbuild": "^0.28.0",
    "jsdom": "^29.1.1",
    "postcss": "^8.4.0",
    "tailwindcss": "^3.4.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vite-tsconfig-paths": "^5.0.0",
    "vitest": "^2.1.0",
    "wait-on": "^7.0.0"
  },
  "private": true
}