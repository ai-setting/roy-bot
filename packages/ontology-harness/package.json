{
  "name": "@ai-setting/roy-bot-ontology-harness",
  "version": "1.5.50",
  "type": "module",
  "description": "Ontology Harness - Domain/industry modeling and constraint validation for roy-bot (Typed Markdown Ontology)",
  "main": "./dist/index.js",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist/**/*",
    "README.md"
  ],
  "scripts": {
    "build": "bunup",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@ai-setting/roy-bot-coder-harness": "workspace:*",
    "@ai-setting/roy-bot-core": "workspace:*",
    "markdown-it": "^14.1.1",
    "vscode-languageserver-types": "^3.17.5",
    "vscode-uri": "^3.0.8",
    "yaml": "^2.3.0"
  },
  "devDependencies": {
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^20.0.0",
    "bunup": "^0.16.0",
    "typescript": "^5.3.0",
    "vitest": "^2.0.0"
  },
  "engines": {
    "node": ">=18.0.0"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ai-setting/roy-bot.git",
    "directory": "packages/ontology-harness"
  },
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "keywords": [
    "roy-bot",
    "agent",
    "ai",
    "ontology",
    "harness",
    "typed-markdown"
  ],
  "author": "ai-setting",
