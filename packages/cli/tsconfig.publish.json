{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2022"],
    "types": ["node"],
    "outDir": "./dist",
    "rootDir": "..",
    "strict": false,
    "noImplicitAny": false,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true,
    "resolveJsonModule": true,
    "declaration": true,
    "declarationMap": true,
    "sourceMap": true,
    "experimentalDecorators": true,
    "noEmitOnError": false,
    "paths": {
      "@ai-setting/roy-bot-core": ["./core/src"],
      "@ai-setting/roy-bot-core/*": ["./core/src/*"],
      "@ai-setting/roy-bot-coder-harness": ["./coder-harness/src"],
      "@ai-setting/roy-bot-coder-harness/*": ["./coder-harness/src/*"]
    }
  },
  "include": [
    "cli/src/**/*.ts",
    "core/src/**/*.ts",
    "coder-harness/src/**/*.ts"
  ],
  "exclude": [
    "**/node_modules",
    "**/*.test.ts",
    "**/*.test.tsx",
    "**/*.spec.ts",
    "**/*.spec.tsx",
    "**/__tests__/**",
    "**/__integration__/**"
  ]
}
