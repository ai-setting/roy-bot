{
  "name": "@roy-bot/workspace",
  "version": "1.3.13",
  "private": true,
  "description": "Intelligent OS framework for AI agents",
  "scripts": {
    "build": "pnpm -r --filter='./packages/*' run build",
    "build:cli:dev:single": "bun run scripts/build-cli-dev.ts",
    "build:cli:prod": "bun run scripts/build-cli-prod.ts",
    "build:cli:prod:single": "bun run scripts/build-cli-prod.ts --single",
    "publish:full": "bun run scripts/publish-full.ts",
    "publish:full:dry-run": "bun run scripts/publish-full.ts --dry-run",
    "install:local": "bun run scripts/install-local.ts",
    "verify:npm-install": "bun run scripts/verify-npm-install.ts",
    "build:standalone": "bun run scripts/build-standalone.ts",
    "build:standalone:all": "bun run scripts/build-standalone.ts --all",
    "build:standalone:publish": "bun run scripts/build-standalone.ts --publish",
    "build:standalone:all:publish": "bun run scripts/build-standalone.ts --all --publish",
    "build:desktop": "bun run scripts/build-desktop-prod.ts",
    "desktop:dev": "pnpm --filter=@ai-setting/roy-bot-desktop dev:electron",
    "build:desktop:dev": "bun run scripts/build-desktop-dev.ts",
    "build:desktop:release": "bun run scripts/build-desktop-release.ts",
    "clean": "rm -rf packages/*/dist",
    "workflow:pev": "bun run packages/cli/dist/bin/roy-bot.js workflow run workflows/task-pev-agent.workflow.yaml --file",
    "workflow:pev:verify": "bun run scripts/verify-task-pev-workflow.ts",
    "workflow:pev:scenarios": "bun run scripts/verify-task-pev-scenarios.ts",
    "workflow:pev:fail-loop": "bun run scripts/verify-task-pev-fail-loop.ts",
    "publish:dry-run": "pnpm -r --filter=./packages/* exec pnpm pack --dry-run",
    "publish": "pnpm run build && pnpm -r --filter=./packages/* exec pnpm publish --access public --no-git-checks",
    "test": "bun test",
    "test:fast": "bun test --parallel=4 --timeout 30000 --path-ignore-patterns='**/desktop/**' packages/",
    "test:cli": "bun test packages/cli",
    "test:cli:fast": "bun test --parallel=4 --timeout 30000 --path-ignore-patterns='**/desktop/**' packages/cli",
    "test:core": "bun test packages/core",
    "test:core:fast": "bun test --parallel=4 --timeout 30000 --path-ignore-patterns='**/desktop/**' packages/core",
    "test:packages": "bun test packages/",
    "test:packages:fast": "bun test --parallel=4 --timeout 30000 --path-ignore-patterns='**/desktop/**' packages/"
  },
  "workspaces": [
    "packages/*"
  ],
  "devDependencies": {
    "@types/jsdom": "^28.0.1",
    "bun-types": "^1.0.0",
    "bunup": "^0.16.0",
    "typescript": "^5.9.3",
    "vite": "^6.0.0",
    "vitest": "^4.1.5"
  },
  "packageManager": "pnpm@9.0.0",
  "dependencies": {
    "@ai-sdk/anthropic": "^3.0.0",
    "@ai-sdk/google": "^3.0.0",
    "@ai-sdk/openai": "^3.0.0",
    "@ai-sdk/openai-compatible": "^2.0.51",
    "@ai-setting/markdown-language-server": "0.5.6",
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@opentui/core": "^0.6.6",
    "@opentui/react": "^0.6.6",
    "@opentui/solid": "^0.6.6",
    "ai": "^6.0.0",
    "glob": "^13.0.6",
    "jsonc-parser": "^3.2.0",
    "markdown-it": "^14.1.0",
    "minimatch": "^10.0.0",
    "reflect-metadata": "^0.2.2",
    "solid-js": "^1.9.17",
    "vscode-jsonrpc": "^8.2.0",
    "vscode-languageserver-protocol": "^3.17.5",
    "vscode-languageserver-types": "^3.17.5",
    "vscode-uri": "^3.0.8",
    "ws": "^8.16.0",
    "xdg-basedir": "^5.1.0",
    "yaml": "^2.3.0",
    "zod": "^3.25.0",
    "zod-to-json-schema": "^3.25.2"
  },
  "packages/roy-bot-standalone/version": "1.5.0",
  "packages/roy-bot-standalone/package": {
    "json:version": "1.5.0"
  }
}
